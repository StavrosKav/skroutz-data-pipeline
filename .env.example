# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# ═══════════════════════════════════════════════════════════════════════════
# PostgreSQL Connection
# ═══════════════════════════════════════════════════════════════════════════
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=SkroutzPR

# Read-only role used only by /ask and /analyze (created by python -m ops.create_ask_role).
# /ask refuses to start without it and never falls back to DB_USER.
ASK_DB_USER=skroutz_ask
ASK_DB_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════════
# Gmail Alert on Pipeline Failure (optional)
# Generate an App Password at: myaccount.google.com > Security > App Passwords
# ═══════════════════════════════════════════════════════════════════════════
ALERT_EMAIL=your_gmail@gmail.com
GMAIL_APP_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════════
# Telegram Bot (optional)
# 1. Message @BotFather on Telegram → /newbot to get a token
# 2. Message @userinfobot to get your chat ID
# ═══════════════════════════════════════════════════════════════════════════
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ═══════════════════════════════════════════════════════════════════════════
# NVIDIA NIM API (for LLM-powered bot features)
# Get API key at: https://build.nvidia.com (NVIDIA account required)
# Models used (2026-10): primary nvidia/nemotron-3-ultra-550b-a55b,
# fallback nvidia/nemotron-3.5-bolt-e4b, then openai/gpt-oss-20b.
# The free catalog changes; access is opt-in per model on build.nvidia.com.
# ═══════════════════════════════════════════════════════════════════════════
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ═══════════════════════════════════════════════════════════════════════════
# Pipeline Settings (optional)
# ═══════════════════════════════════════════════════════════════════════════
# Set to "1" to skip scraping (Stage 1) — used in Docker
SKIP_SCRAPE=0

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Timezone for scheduled tasks
TZ=Europe/Athens